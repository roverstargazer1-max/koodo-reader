{
  "name": "koodo-reader-personal",
  "main": "main.js",
  "version": "0.2.0",
  "description": "A Windows-first personal library derived from Koodo Reader with built-in JMComic integration",
  "author": {
    "name": "roverstargazer1-max"
  },
  "engines": {
    "node": "22.x",
    "yarn": "1.22.22"
  },
  "packageManager": "yarn@1.22.22",
  "repository": "https://github.com/roverstargazer1-max/koodo-reader-personal",
  "private": false,
  "resolutions": {
    "@types/react": "^18.3.1",
    "node-gyp": "^10.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.564.0",
    "@mozilla/readability": "^0.6.0",
    "axios": "0.31.1",
    "basic-ftp": "5.3.1",
    "better-sqlite3": "11.10.0",
    "buffer": "^6.0.3",
    "chardet": "^2.0.0",
    "color-thief-browser": "^2.0.2",
    "copy-text-to-clipboard": "^2.2.0",
    "crypto-js": "^4.2.0",
    "discord-rpc": "^4.0.1",
    "dompurify": "3.4.0",
    "electron-is-dev": "^1.1.0",
    "electron-log": "^5.4.3",
    "electron-store": "^8.0.1",
    "fflate": "^0.8.2",
    "file-saver": "^2.0.5",
    "form-data": "4.0.4",
    "fs-extra": "^9.1.0",
    "hammerjs": "^2.0.8",
    "howler": "^2.2.3",
    "https-proxy-agent": "^7.0.6",
    "js-mdict": "6.0.8",
    "js-untar": "^2.0.0",
    "jszip": "^3.10.1",
    "localforage": "^1.10.0",
    "mammoth": "^1.8.0",
    "marked": "^15.0.11",
    "megajs": "^1.3.9",
    "mhtml2html": "^3.0.0",
    "node-machine-id": "^1.1.12",
    "qs": "^6.11.2",
    "rangy": "1.3.0",
    "react-hot-toast": "^2.1.1",
    "react-sortablejs": "^6.1.4",
    "react-tooltip": "^5.28.0",
    "recharts": "^3.8.1",
    "socks-proxy-agent": "^8.0.3",
    "sortablejs": "^1.15.6",
    "sse.js": "^2.6.0",
    "ssh2-sftp-client": "^11.0.0",
    "underscore": "^1.13.7",
    "uuid": "^11.0.5",
    "webdav": "^5.7.1",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@types/copy-text-to-clipboard": "^2.0.4",
    "@types/file-saver": "^2.0.7",
    "@types/hammerjs": "^2.0.46",
    "@types/i18next": "^13.0.0",
    "@types/node": "^13.13.2",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@types/react-i18next": "^8.1.0",
    "@types/react-router-dom": "^5.1.6",
    "@types/react-tooltip": "^4.2.4",
    "@types/underscore": "^1.13.0",
    "@types/ws": "^8.5.5",
    "classnames": "^2.2.6",
    "concurrently": "^5.0.1",
    "cross-env": "^6.0.3",
    "electron": "^34.0.1",
    "electron-builder": "^26.0.12",
    "electron-rebuild": "^3.2.9",
    "hard-source-webpack-plugin": "^0.13.1",
    "html-react-parser": "^5.1.10",
    "i18next": "^23.11.5",
    "lottie-react": "^2.4.0",
    "nodemon": "^3.1.3",
    "react": "^18.3.1",
    "react-colorful": "^5.6.1",
    "react-device-detect": "^2.2.3",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.2.3",
    "react-i18next": "^14.1.3",
    "react-redux": "^8.1.3",
    "react-router-dom": "^5.2.0",
    "react-scripts": "^5.0.1",
    "redux": "^4.0.5",
    "redux-thunk": "^2.3.0",
    "source-map-explorer": "^2.5.2",
    "typescript": "^5.9.3",
    "wait-on": "^7.0.1"
  },
  "scripts": {
    "analyze": "source-map-explorer 'build/static/js/*.js'",
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "ele": "electron .",
    "setup": "node scripts/setup.js",
    "setup:python": "node scripts/setup-python.js",
    "check:env": "node scripts/check-environment.js",
    "typecheck": "tsc --noEmit --noUnusedLocals false --noUnusedParameters false",
    "test:jmcomic-runtime": "node --test scripts/jmcomic/runtime.test.js",
    "test:pica": "node --test scripts/pica/*.test.js",
    "build:jmcomic-sidecar": "node scripts/build-jmcomic-sidecar.js",
    "dev": "node scripts/check-environment.js && concurrently \"cross-env BROWSER=none yarn start\" \"wait-on http://127.0.0.1:3000/ && nodemon --watch main.js --watch src/utils/plugins/main --watch scripts/jmcomic --watch scripts/pica --ext js --exec \\\"electron .\\\"\"",
    "package:win": "yarn build && yarn build:jmcomic-sidecar && electron-builder --win --x64 --publish never",
    "release": "yarn build:jmcomic-sidecar && electron-builder --win --x64",
    "prerelease": "yarn build",
    "postinstall": "node scripts/patch-nan.js && electron-rebuild -f -w better-sqlite3",
    "rebuild": "electron-rebuild -f -w better-sqlite3"
  },
  "homepage": "./",
  "build": {
    "appId": "io.github.roverstargazer1max.koodoreaderpersonal",
    "productName": "Koodo Reader Personal",
    "copyright": "Copyright (c) 2026 roverstargazer1-max and Koodo Reader contributors",
    "files": [
      "build/**/*",
      "!build/pyinstaller/**/*",
      "node_modules/**/*",
      "package.json",
      "src/assets/lib/kookit-extra.min.mjs",
      "src/utils/plugins/main/**/*.js",
      "scripts/jmcomic/jmcomicManager.js",
      "scripts/jmcomic/runtime.js",
      "scripts/pica/**/*.js",
      "main.js",
      "preload.js",
      "chat-preload.js"
    ],
    "extraResources": [
      {
        "from": "dist-sidecar/jmcomic-bridge",
        "to": "jmcomic-bridge"
      }
    ],
    "protocols": {
      "name": "KoodoReader",
      "schemes": [
        "koodo-reader"
      ]
    },
    "directories": {
      "buildResources": "assets"
    },
    "publish": {
      "provider": "github",
      "repo": "koodo-reader-personal",
      "owner": "roverstargazer1-max"
    },
    "buildDependenciesFromSource": false,
    "nodeGypRebuild": false,
    "npmRebuild": false,
    "fileAssociations": [
      {
        "ext": "epub",
        "icon": "assets/icons/epub",
        "role": "Viewer",
        "mimeType": "application/epub+zip"
      },
      {
        "ext": "pdf",
        "icon": "assets/icons/pdf",
        "role": "Viewer",
        "mimeType": "application/pdf"
      },
      {
        "ext": "mobi",
        "icon": "assets/icons/mobi",
        "role": "Viewer",
        "mimeType": "application/x-mobipocket-ebook"
      },
      {
        "ext": "azw3",
        "icon": "assets/icons/azw3",
        "role": "Viewer",
        "mimeType": "application/vnd.amazon.ebook"
      },
      {
        "ext": "azw",
        "icon": "assets/icons/azw3",
        "role": "Viewer",
        "mimeType": "application/vnd.amazon.ebook"
      },
      {
        "ext": "cbz",
        "icon": "assets/icons/comic",
        "role": "Viewer",
        "mimeType": "application/x-cbz"
      },
      {
        "ext": "cbr",
        "icon": "assets/icons/comic",
        "role": "Viewer",
        "mimeType": "application/x-cbr"
      },
      {
        "ext": "cbt",
        "icon": "assets/icons/comic",
        "role": "Viewer",
        "mimeType": "application/x-cbt"
      },
      {
        "ext": "cb7",
        "icon": "assets/icons/comic",
        "role": "Viewer",
        "mimeType": "application/x-cb7"
      },
      {
        "ext": "fb2",
        "icon": "assets/icons/fb2",
        "role": "Viewer",
        "mimeType": "application/x-fictionbook+xml"
      }
    ],
    "extends": null,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icons/icon.ico",
      "signAndEditExecutable": false,
      "artifactName": "Koodo-Reader-Personal-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Koodo-Reader-Personal-${version}-${arch}-Portable.${ext}"
    },
    "nsis": {
      "artifactName": "Koodo-Reader-Personal-${version}-${arch}-Setup.${ext}",
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "buildUniversalInstaller": false,
      "include": "assets/windows/installer.nsh"
    }
  },
  "eslintConfig": {
    "extends": "react-app",
    "rules": {
      "no-unused-vars": 2
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "babel": {
    "presets": [
      "react-app"
    ]
  }
}
